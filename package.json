{
  "name": "recipe-box",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5188 --strictPort",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests worker/src *.ts *.json index.html",
    "format:check": "prettier --check src tests worker/src *.ts *.json index.html",
    "icons": "node scripts/generate-icons.mjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
